# =====================================================================
# AI Job Recommendation Agent - Environment Variables Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Gemini AI Configuration
# ---------------------------------------------------------------------
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# 2. Candidate & Notification Settings
# ---------------------------------------------------------------------
CANDIDATE_NAME="Candidate"
CANDIDATE_EMAIL=candidate_email@example.com
MIN_MATCH_SCORE_TO_EMAIL=75
MAX_JOB_AGE_HOURS=24
SAFETY_BUFFER_MINUTES=15
TIMEZONE="Asia/Kolkata"
SCHEDULE_INTERVAL_MINUTES=55

# ---------------------------------------------------------------------
# 3. SMTP Email Configuration (Nodemailer)
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Job Hunter AI <noreply@jobhunter.ai>"
ALERT_RECEIVER_EMAIL=your_email@gmail.com

# ---------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL or SQLite)
# ---------------------------------------------------------------------
USE_SQLITE=false
DATABASE_URL=postgresql://jobagent:jobagent_pass@localhost:5432/jobagent_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=jobagent_db
PGUSER=jobagent
PGPASSWORD=jobagent_pass

# ---------------------------------------------------------------------
# 5. External Job Search API Keys (Optional but Recommended)
# ---------------------------------------------------------------------
# RapidAPI JSearch Key (https://rapidapi.com/letscrape-6bRBa3qigO/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ---------------------------------------------------------------------
# 6. Execution Schedule
# ---------------------------------------------------------------------
# Runs every 55 minutes automatically
SCHEDULE_INTERVAL_MINUTES=55
CRON_SCHEDULE="*/55 * * * *"
