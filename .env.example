# =====================================================================
# Job Hunter AI - Multi-Channel Near-Real-Time Environment Configuration
# =====================================================================

PORT=3000

# =====================================================================
# 1. Google Gemini AI Configuration
# =====================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# =====================================================================
# 2. Candidate & Discovery Settings
# =====================================================================
CANDIDATE_NAME="Vijayasimha Tammineni"
CANDIDATE_EMAIL=your_email@gmail.com
ALERT_RECEIVER_EMAIL=your_email@gmail.com
MIN_MATCH_SCORE=65
MIN_MATCH_SCORE_CRITICAL=60
MAX_JOB_AGE_HOURS=40
TIMEZONE="Asia/Kolkata"

# =====================================================================
# 3. Near Real-Time Polling Strategy
# =====================================================================
POLL_INTERVAL_FAST_MINUTES=2
POLL_INTERVAL_NORMAL_MINUTES=5
POLL_INTERVAL_RESTRICTED_MINUTES=15
AGGREGATION_WINDOW_MINUTES=2

# =====================================================================
# 4. Multi-Channel Notification Toggles
# =====================================================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_TELEGRAM_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# =====================================================================
# 5. Channel 1: Email (Nodemailer + Gmail SMTP)
# =====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Job Hunter AI <your_email@gmail.com>"

# =====================================================================
# 6. Channel 2: Telegram Bot API
# =====================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =====================================================================
# 7. Channel 3: Push Notifications (Firebase Cloud Messaging)
# =====================================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# =====================================================================
# 8. Persistent Database (Supabase / PostgreSQL or SQLite)
# =====================================================================
USE_SQLITE=false
DATABASE_URL=postgresql://jobagent:jobagent_pass@localhost:5432/jobagent_db
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# =====================================================================
# 9. External Job Search API Keys
# =====================================================================
RAPIDAPI_KEY=your_rapidapi_jsearch_key
JSEARCH_API_KEY=your_rapidapi_jsearch_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
