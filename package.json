{
  "name": "ai-job-recommendation-agent",
  "version": "1.1.0",
  "description": "AI-powered job discovery, matching, and notification agent for early-career Java Full Stack Developers in India",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
